# Runtime
DRY_RUN=true
LOG_LEVEL=INFO
LOG_FILE=logs/predictbot.log
POLL_INTERVAL_SECONDS=2

# API environment: prod | testnet
PREDICT_ENV=prod
PREDICT_API_KEY=
PREDICT_WALLET_PRIVATE_KEY=
PREDICT_SIGNER_ADDRESS=

# Optional: If using Predict account/deposit address mode
PREDICT_ACCOUNT_ADDRESS=

# Trading scope
TARGET_MARKET_IDS=123
MAX_ORDER_USDT=20
# Global cost cap / (wallet USDT balance + remaining position cost).
# 0.30 = 30%; 0 blocks all new BUY orders. SELL orders are unaffected.
MAX_POSITION_COST_RATIO=0.30
MAX_OPEN_ORDERS=5

# Strategy
STRATEGY_ENABLED=true
STRATEGY_MODE=market_maker
STRATEGY_BASE_ORDER_SIZE=10
STRATEGY_MIN_SPREAD=0.02
STRATEGY_MIN_IMBALANCE=0.10
STRATEGY_COOLDOWN_SECONDS=3

# Market maker strategy
# MM_OUTCOME: AUTO (recommended) | YES | NO
#   AUTO — always quote on the high-probability side (mid > 0.50)
#   YES / NO — fixed outcome regardless of market price
MM_OUTCOME=AUTO
# Minimum probability the high-probability side must reach before quoting.
# Prevents quoting in near-50/50 markets where the edge is thin.  Range [0.50, 1.0).
MM_MIN_PROBABILITY=0.55
MM_QUOTE_SIZE=8
MM_MIN_ORDER_VALUE_USDT=0.95
MM_HALF_SPREAD_BPS=60
MM_MIN_SPREAD_BPS=20
MM_REFRESH_SECONDS=2.5
MM_MIN_LEVEL_SIZE=1
MM_MAX_POSITION_SHARES=50
MM_INVENTORY_SKEW_BPS=30
MM_POSITION_RECONCILE_SECONDS=30

# Optional fixed order expiration (seconds)
ORDER_EXPIRATION_SECONDS=300

# Optional custom EIP712 config (only needed if your signer implementation requires it)
EIP712_DOMAIN_NAME=PredictExchange
EIP712_DOMAIN_VERSION=1
EIP712_CHAIN_ID=56
EIP712_VERIFYING_CONTRACT=

# Redis (optional) — leave REDIS_URL empty to disable and use in-memory cache only
# When set, inventory positions are written to Redis after every reconcile and
# loaded on startup for a warm-start after restarts.
REDIS_URL=
REDIS_POSITIONS_KEY=predictbot:positions
REDIS_POSITIONS_TTL=300
